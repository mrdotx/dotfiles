general {
    output_format = "i3bar"
    colors = true
    color_good = "#ffffff"
    color_degraded = "#b0b200"
    color_bad = "#df2800"
    interval = 5
}

order += "wireless _first_"
order += "volume master"
order += "battery all"
order += "time"

wireless _first_ {
    format_up = "󰤨 %quality %bitrate"
    format_down = "󰤭"
}

volume master {
    format = "󰕾 %volume"
    format_muted = "󰝟"
    device = "default"
    mixer = "PCM"
    mixer_idx = 0
}

battery all {
    status_bat = "󰂌"
    status_chr = "󰂄"
    status_unk = "󰂑"
    status_full = "󰁹"
    last_full_capacity = true
    format = "%status %percentage %remaining"
    format_down = "󱉝"
    low_threshold = 20
}

time {
    format = "󰥔 %a %d.%m.%Y %H:%M"
}
