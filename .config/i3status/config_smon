general {
        output_format = "i3bar"
        colors = true
        interval = 5
}

order += "wireless _first_"
order += "volume master"
#order += "battery 0"
order += "time"

wireless _first_ {
        color_good = "#ffffff"
        color_degraded = "#b0b200"
        color_bad = "#df2800"
        format_up = "󰤨 %quality %bitrate"
        format_down = "󰤭"
}

volume master {
        format = "󰕾 %volume"
        format_muted = "󰝟"
        device = "default"
        mixer = "Master"
        mixer_idx = 0
}

battery 0 {
        status_bat = "󰂌"
        status_chr = "󰂄"
        status_unk = "󰂑"
        status_full = "󰁹"
        last_full_capacity = true
        format = "%status %percentage %remaining"
}

time {
        format = "󰥔 %a %d.%m.%Y %H:%M"
}

